# Anthropic Claude API Key
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenMetadata Server URL (default for local Docker)
OPENMETADATA_HOST=http://localhost:8585

# OpenMetadata JWT token
# Get it from: OpenMetadata UI → Settings → Bots → ingestion-bot → Token
OPENMETADATA_TOKEN=your_openmetadata_jwt_token_here
